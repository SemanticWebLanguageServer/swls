@prefix foaf: <http://xmlns.com/foaf/0.1/>.
@prefix mtg: <https://mtg.example.org/ontology#>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix sh: <http://www.w3.org/ns/shacl#>.

[ ] a sh:NodeShape;
  sh:property [ sh:path <> ].

[ ] rdf:type mtg:Card.
<abc> a "test"^^xsd:datatime, foaf:Agent.
<me> foaf:knows <abc>.
[ ] a sh:NodeShape;
  sh:property [ ].

[ ] a sh:NodeShape;
  sh:property [ sh:name "" ].

